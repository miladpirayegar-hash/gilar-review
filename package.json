{
  "name": "gilar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:review": "node scripts/build-review.mjs",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "qbo:verify": "tsx scripts/verify-quickbooks-sandbox.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test tests/e2e/synthetic-journey.spec.ts tests/e2e/simplified-experience.spec.ts",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "lucide-react": "latest",
    "pg": "^8.23.1",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "vite": "latest",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "latest",
    "vitest": "^5.0.5"
  }
}
